# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/

# Vector store
.chroma/

# Raw data (large; use data/download_data.py)
data/raw/*
!data/raw/.gitkeep

# Processed data (rebuilt by src/clean.py)
data/processed/*
!data/processed/.gitkeep
# Committed for Streamlit Cloud cold start (deployment data strategy, Option A);
# the app builds the .chroma/ index from this at startup, and the EDA panel
# reads the quality report directly.
!data/processed/reviews_clean.parquet
!data/processed/quality_report.json

# Jupyter
.ipynb_checkpoints/

# BMAD personal overrides
_bmad/**/*.user.toml

# macOS
.DS_Store

# BMAD skill render cache (machine-local, regenerated)
_bmad/render/

# Local application notes (not part of the project)
docs/application-paragraph.md

# Blind grading sheet (local working file)
eval/grading/
